rules_version = '2';

// ══════════════════════════════════════════════════════════════════════
//  TC StepUp 2026 — 하이플래너 자가진단 레포트
//
//  읽기 : 익명 인증을 통과한 세션만. 앱은 공통 비밀번호 검증에 성공한
//         뒤에만 signInAnonymously() 를 호출한다.
//         ⚠️ 비밀번호를 아는 사람은 임의의 사번을 조회할 수 있다.
//            완전 격리가 필요하면 사번별 계정 발급으로 전환해야 한다.
//
//  쓰기 : 관리자만. 관리자 여부는 admins/{uid} 문서 존재로 판정한다 —
//         admin 화면의 "관리자 추가하기"가 사번/비밀번호/성명으로 새
//         Firebase Auth 계정을 만들고 이 문서를 함께 기록한다(src/session.ts
//         createAdminAccount 참고). 최초 부트스트랩 관리자 1명만 Firebase
//         콘솔에서 수동으로 계정 + 문서를 만들면, 그다음부터는 화면에서
//         서로 새 관리자를 추가할 수 있다(README "최초 설정" 참고).
//         아래 UID 배열은 예전 방식(콘솔에서 UID를 직접 넣던 방식)과의
//         호환을 위해 남겨 둔다 — 비워 둬도 무방하다.
// ══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid in [
          'REPLACE_WITH_ADMIN_UID'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 관리자 계정 목록 (문서 ID = Firebase Auth UID, {code, name, createdAt}).
    // 관리자만 읽고 쓸 수 있다 — "관리자 추가하기"로 새 관리자를 등록하는 것도
    // 결국 관리자만 할 수 있는 쓰기 작업이다.
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // 플래너 데이터 (해시 샤딩, 256개 문서)
    match /plannerShards/{shardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 소득구간별 벤치마크 (문서 1개)
    match /benchmarks/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 메타데이터
    match /meta/{docId} {
      // auth 문서에는 뷰어 비밀번호 해시가 들어 있다.
      // 로그인 전에 읽어야 하므로 공개 읽기를 허용한다.
      // (SHA-256 해시만 저장하며 평문은 어디에도 두지 않는다)
      allow read: if docId == 'auth' || signedIn();
      allow write: if isAdmin();
    }

    // "명단에서 선택" 화면에서 지역단별로 저장해 두는 TC스텝업 대상자 목록
    // (문서 1개당 사번 배열 하나뿐 — 실제 조직 데이터는 아니다).
    // 뷰어 비밀번호를 아는 사람은 이미 모든 사번을 조회할 수 있으므로(위 주석 참고),
    // 같은 신뢰 범위 안에서 읽기/쓰기 모두 signedIn() 으로 둔다.
    match /stepupTargets/{hqId} {
      allow read, write: if signedIn();
    }

    // 그 외 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
